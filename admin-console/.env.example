# Same backend deployment, routed through the admin-only host at the edge.
ADMIN_BACKEND_ORIGIN=https://api.example.invalid

# Optional explicit browser-side API base. Leave as /api when using the
# Next.js rewrite above so the admin session cookie remains host-only.
NEXT_PUBLIC_ADMIN_API_URL=/api
NEXT_PUBLIC_APP_URL=https://gnxsales.com
